<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- ProMotion: without this, iPhone caps every Core Animation display
	     link and animation in the app — SwiftUI's own included — at 60Hz,
	     and a scroll pans at 120 while what SwiftUI changes during it moves
	     at 60. UIKit scrolling alone is exempt; this lifts the cap. -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.griffin.magic-hat.catalog-refresh</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>The camera reads a card's name and set so you can add it to a collection. Nothing is recorded or uploaded.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Choose a photo of a card to scan it.</string>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>processing</string>
	</array>
</dict>
</plist>
